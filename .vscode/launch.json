{
    // C Debbugger launch configuration for tp3.c file
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C Debbugger",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tp3.c",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gcc",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
    
}